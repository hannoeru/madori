{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "madori",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public"
  },
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "madori-preview",
    "database_id": "89749563-c38c-4747-be8d-ec5a53535496",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{
    "binding": "LISTING_IMAGES",
    "bucket_name": "madori-preview-images"
  }],
  "ratelimits": [{
    "name": "LOGIN_RATE_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }],
  "env": {
    "preview": {
      "name": "madori-preview",
      "d1_databases": [{
        "binding": "DB",
        "database_name": "madori-preview",
        "database_id": "89749563-c38c-4747-be8d-ec5a53535496",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{
        "binding": "LISTING_IMAGES",
        "bucket_name": "madori-preview-images"
      }],
      "ratelimits": [{
        "name": "LOGIN_RATE_LIMIT",
        "namespace_id": "1001",
        "simple": { "limit": 10, "period": 60 }
      }]
    },
    "production": {
      "name": "madori-production",
      "d1_databases": [{
        "binding": "DB",
        "database_name": "madori-production",
        "database_id": "5c80e0e1-93e0-4e9c-a8ff-677184f65c67",
        "migrations_dir": "migrations"
      }],
      "r2_buckets": [{
        "binding": "LISTING_IMAGES",
        "bucket_name": "madori-production-images"
      }],
      "ratelimits": [{
        "name": "LOGIN_RATE_LIMIT",
        "namespace_id": "1002",
        "simple": { "limit": 10, "period": 60 }
      }]
    }
  }
}
