# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=
# Session encryption (>= 32 chars); used by nuxt-auth-utils sessions
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-random-characters
# Password for the owner login at /login. Use a long random value.
NUXT_ADMIN_PASSWORD=
